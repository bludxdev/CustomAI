/* Markdown -> безопасный HTML, живой вывод ответа, плавная прокрутка. Экспорт: window.Render */
(function () {
  'use strict';

  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  function inline(src) {
    const codes = [];
    let s = src.replace(/`([^`\n]+)`/g, (_, c) => { codes.push(c); return '\u0000' + (codes.length - 1) + '\u0000'; });
    s = esc(s);
    s = s.replace(/\[([^\]\n]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
    s = s.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/(^|[^*\w])\*([^*\s][^*\n]*?)\*(?![*\w])/g, '$1<em>$2</em>');
    s = s.replace(/~~([^~\n]+)~~/g, '<del>$1</del>');
    return s.replace(/\u0000(\d+)\u0000/g, (_, i) => '<code>' + esc(codes[+i]) + '</code>');
  }

  /* Таблицы: | a | b | + строка-разделитель |---|---| */
  const SEP = /^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$/;
  const cells = (line) => line.trim().replace(/^\|/, '').replace(/\|$/, '').split('|').map((c) => c.trim());

  /* Блок ```ask: первая строка — вопрос, пункты списка — варианты ответа. */
  function ask(lines, closed) {
    const q = [];
    const opts = [];
    for (const l of lines) {
      const m = l.match(/^\s*(?:[-*•]|\d+[.)])\s+(.*)$/);
      if (m) { if (m[1].trim()) opts.push(m[1].trim()); }
      else if (l.trim() && !opts.length) q.push(l.trim());
    }
    return '<div class="ask"' + (closed ? '' : ' data-pending') + '><p class="ask-q">' + inline(q.join(' ')) + '</p><div class="ask-opts">' +
      opts.map((o) => '<button type="button" class="ask-opt"' + (closed ? '' : ' disabled') + ' data-value="' + esc(o.replace(/[*`~]/g, '')) + '">' + inline(o) + '</button>').join('') +
      '</div></div>';
  }

  const markdown = (text) => blocks(text).join('');

  /* Каждый элемент массива — ровно один блочный HTML-элемент. */
  function blocks(text) {
    const lines = String(text || '').replace(/\r\n?/g, '\n').split('\n');
    const out = [];
    let para = [];
    let list = null;
    const flushPara = () => { if (para.length) { out.push('<p>' + para.map(inline).join('<br>') + '</p>'); para = []; } };
    const flushList = () => { if (list) { out.push('<' + list.tag + '>' + list.items.map((i) => '<li>' + inline(i) + '</li>').join('') + '</' + list.tag + '>'); list = null; } };
    const flush = () => { flushPara(); flushList(); };

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      const fence = line.match(/^\s*```\s*([\w+#.-]*)\s*$/);
      if (fence) {
        flush();
        const code = [];
        i++;
        while (i < lines.length && !/^\s*```\s*$/.test(lines[i])) code.push(lines[i++]);
        if (fence[1].toLowerCase() === 'ask') { out.push(ask(code, i < lines.length)); continue; }
        out.push('<div class="codeblock"><header><span>' + esc(fence[1] || 'код') + '</span><button type="button" data-copy>Копировать</button></header><pre><code>' + esc(code.join('\n')) + '</code></pre></div>');
        continue;
      }
      if (!line.trim()) { flush(); continue; }
      if (line.includes('|') && i + 1 < lines.length && lines[i + 1].includes('|') && SEP.test(lines[i + 1])) {
        flush();
        const head = cells(line);
        const align = cells(lines[i + 1]).map((c) => (/^:-+:$/.test(c) ? 'center' : /-:$/.test(c) ? 'right' : ''));
        const rows = [];
        i += 2;
        while (i < lines.length && lines[i].trim() && lines[i].includes('|')) rows.push(cells(lines[i++]));
        i--;
        const cell = (tag, c, k) => '<' + tag + (align[k] ? ' style="text-align:' + align[k] + '"' : '') + '>' + inline(c || '') + '</' + tag + '>';
        out.push('<div class="table-wrap"><table><thead><tr>' + head.map((c, k) => cell('th', c, k)).join('') + '</tr></thead><tbody>' +
          rows.map((r) => '<tr>' + head.map((_, k) => cell('td', r[k], k)).join('') + '</tr>').join('') + '</tbody></table></div>');
        continue;
      }
      const h = line.match(/^(#{1,3})\s+(.*)$/);
      if (h) { flush(); out.push('<h' + h[1].length + '>' + inline(h[2]) + '</h' + h[1].length + '>'); continue; }
      const q = line.match(/^>\s?(.*)$/);
      if (q) { flush(); out.push('<blockquote>' + inline(q[1]) + '</blockquote>'); continue; }
      const ul = line.match(/^\s*[-*•]\s+(.*)$/);
      const ol = line.match(/^\s*\d+[.)]\s+(.*)$/);
      if (ul || ol) {
        flushPara();
        const tag = ul ? 'ul' : 'ol';
        if (!list || list.tag !== tag) { flushList(); list = { tag, items: [] }; }
        list.items.push((ul || ol)[1]);
        continue;
      }
      flushList();
      para.push(line);
    }
    flush();
    return out;
  }

  /* Живой вывод: символы появляются с плавным проявлением, курсор всегда последний. */
  const FADE_LIMIT = 2500;
  function liveWriter(node) {
    node.classList.add('live');
    node.textContent = '';
    const caret = document.createElement('span');
    caret.className = 'caret';
    node.appendChild(caret);
    let animated = 0;
    return {
      push(chunk) {
        if (!chunk) return;
        const frag = document.createDocumentFragment();
        if (animated > FADE_LIMIT || chunk.length > 220) {
          frag.appendChild(document.createTextNode(chunk));
        } else {
          let i = 0;
          for (const ch of chunk) {
            const s = document.createElement('span');
            s.className = 'ch';
            s.style.animationDelay = Math.min(i++ * 7, 160) + 'ms';
            s.textContent = ch;
            frag.appendChild(s);
          }
          animated += i;
        }
        node.insertBefore(frag, caret);
      },
      finish(fullText) {
        node.classList.remove('live');
        node.innerHTML = markdown(fullText);
      },
    };
  }

  /* Плавная прокрутка вниз — только если читатель и так у нижнего края. */
  function scroller(box) {
    let raf = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cancel = () => { if (raf) { cancelAnimationFrame(raf); raf = 0; } };
    const nearBottom = () => box.scrollHeight - box.scrollTop - box.clientHeight < 220;
    const step = () => {
      const delta = box.scrollHeight - box.clientHeight - box.scrollTop;
      if (delta <= 0.5) { raf = 0; return; }
      box.scrollTop += Math.max(0.8, delta * 0.18);
      raf = requestAnimationFrame(step);
    };
    box.addEventListener('wheel', cancel, { passive: true });
    box.addEventListener('touchstart', cancel, { passive: true });
    return {
      cancel,
      pin(force) {
        if (!force && !nearBottom()) return;
        if (reduced || force) { cancel(); box.scrollTop = box.scrollHeight; return; }
        if (!raf) raf = requestAnimationFrame(step);
      },
    };
  }

  window.Render = { esc, markdown, liveWriter, scroller };
})();
